---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Layout/Container.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="feature-page-content-wrapper py-12 px-4 sm:px-6 lg:px-8 min-h-[50vh] flex items-center justify-center font-serif">
    <Container id="dynamic-page-content">
      <h1 class="text-4xl md:text-6xl font-extrabold leading-tight text-center mb-6 text-primary">
        {title}
      </h1>
      <slot />
    </Container>
  </div>

  <section class="text-center mt-12">
    <a href="/" class="inline-flex items-center px-6 py-3 border border-gray-300 shadow-sm text-base font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
      <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H16a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" /></svg>
      Back to Home
    </a>
  </section>

  <style>
    @keyframes featureContentFadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes featureTitleScaleUp {
      from { opacity: 0; transform: scale(0.9); }
      to { opacity: 1; transform: scale(1); }
    }

    .feature-page-content-wrapper h1 {
      opacity: 0;
      transform: scale(0.9);
      animation: featureTitleScaleUp 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
      animation-delay: 0.1s;
      font-family: 'Georgia', serif;
      will-change: transform, opacity;
      transform: translateZ(0);
    }


    /* Animation class for the article */
    .feature-page-content-wrapper .animate-article-content {
      animation: featureContentFadeIn 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
      animation-delay: 0.3s; /* Delay for the whole content block */
      will-change: transform, opacity;
      transform: translateZ(0);
    }
    
    .feature-page-content-wrapper {
      font-family: 'Georgia', serif;
    }
  </style>
</BaseLayout>