---
import BaseLayout from './BaseLayout.astro';
import Container from '../components/Layout/Container.astro'; // Assuming you might use Container here too

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <section class="relative py-24 px-4 sm:px-6 lg:px-8 text-center bg-gradient-to-br from-blue-50 to-white overflow-hidden">
    <div class="absolute -bottom-10 -left-10 w-48 h-48 bg-blue-200 opacity-20 rounded-full mix-blend-multiply filter blur-xl animate-blob z-0"></div>
    <div class="absolute -top-10 -right-10 w-48 h-48 bg-purple-200 opacity-20 rounded-full mix-blend-multiply filter blur-xl animate-blob animation-delay-2000 z-0"></div>
    
    <div class="relative z-10 max-w-5xl mx-auto">
      <slot name="main-content" />
    </div>
  </section>
  
  <slot /> 

</BaseLayout>

<style>

  .animation-delay-2000 {
    animation-delay: 2s;
  }

</style>