---
import BasicPageLayout from '../layouts/BasicPageLayout.astro';
import FeaturePageLayout from '../layouts/FeaturePageLayout.astro';
import { Fragment } from 'astro/runtime/server/index.js';

const { slug } = Astro.params;
const SERVER_SIDE_API_BASE_URL = 'http://web:80/api/pages';

let pageData = null;
try {
  const response = await fetch(`${SERVER_SIDE_API_BASE_URL}/${slug}`);
  if (response.ok) {
    pageData = await response.json();
  } else if (response.status === 404) {
    console.warn(`Page not found for slug: ${slug}`);
  } else {
    console.error(`Failed to fetch page ${slug}: ${response.status} ${response.statusText}`);
  }
} catch (error) {
  console.error(`Error fetching page ${slug}:`, error);
}

const pageTitle = pageData?.title || '404 Page Not Found';
const pageDescription = pageData?.excerpt || (pageData?.content ? pageData.content.substring(0, 150) + '...' : '');

const layoutMap = {
  'feature': FeaturePageLayout,
};

const LayoutComponent = layoutMap[pageData?.type] || BasicPageLayout;
---
<LayoutComponent title={pageTitle} description={pageDescription}>
  
  {pageData ? (
    <article class="w-full max-w-4xl mx-auto card p-8">
      <div class="prose prose-xl max-w-none text-gray-700 leading-relaxed">
        <Fragment set:html={pageData.content} />
      </div>
    </article>
  ) : (
    <p class="text-gray-600 text-lg text-center">Loading content...</p>
  )}

</LayoutComponent>