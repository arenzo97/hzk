---
// src/pages/[slug].astro

export const prerender = true;

import BasicPageLayout from '../layouts/BasicPageLayout.astro';
import FeaturePageLayout from '../layouts/FeaturePageLayout.astro';
import { Fragment } from 'astro/runtime/server/index.js';

export async function getStaticPaths() {
  const BUILD_TIME_API_URL = 'http://web:80/api/pages';

  try {
    const response = await fetch(BUILD_TIME_API_URL);
    if (!response.ok) {
      console.error('Failed to fetch pages for static paths during build:', response.status, response.statusText);
      return [];
    }
    const pages = await response.json();

    const paths = pages
      .filter((page) => page.slug && typeof page.slug === 'string' && page.slug.trim() !== '')
      .map((page) => ({
        params: { slug: page.slug },
        props: { initialPageData: page },
      }));

    return paths;
  } catch (error) {
    console.error('Error fetching pages for static paths during build:', error);
    return [];
  }
}

const { slug } = Astro.params;
const { initialPageData } = Astro.props;

const CLIENT_SIDE_API_BASE_URL = 'http://localhost:8000/api/pages';

const pageTitle = initialPageData?.title || 'Loading Page...';
const pageDescription = initialPageData?.excerpt || (initialPageData?.content ? initialPageData.content.substring(0, 150) + '...' : 'Content page from JLWC.');

const layoutMap = {
  'feature': FeaturePageLayout,
};

const LayoutComponent = layoutMap[initialPageData?.type] || BasicPageLayout;
---
<LayoutComponent title={pageTitle} description={pageDescription}>
  
  {initialPageData ? (
    <article class="w-full max-w-4xl mx-auto card p-8">
      <div class="prose prose-xl max-w-none text-gray-700 leading-relaxed">
        <Fragment set:html={initialPageData.content} />
      </div>
    </article>
  ) : (
    <p class="text-gray-600 text-lg text-center">Loading content...</p>
  )}

  {/* REMOVED THE CONDITIONAL <style> BLOCK FROM HERE */}
  {/* REMOVED THE ANIMATION TRIGGERING SCRIPT FROM HERE */}

  <script define:vars={{ slug, initialPageDataExists: !!initialPageData, CLIENT_SIDE_API_BASE_URL }}>
    async function fetchAndRenderPageContent(pageSlug) {
      const dynamicContentTarget = document.getElementById('dynamic-page-content');
      if (!dynamicContentTarget) {
        console.error('Dynamic content target container not found!');
        return;
      }

      dynamicContentTarget.innerHTML = '<p class="text-gray-600 text-lg text-center">Loading content dynamically...</p>';

      try {
        const response = await fetch(`${CLIENT_SIDE_API_BASE_URL}/${pageSlug}`);
        if (!response.ok) {
          const errorMsg = response.status === 404
            ? 'Page not found.'
            : 'An error occurred loading this page.';
          dynamicContentTarget.innerHTML = `<p class="text-red-600 text-center text-xl">${errorMsg}</p>`;
          document.title = response.status === 404 ? 'Page Not Found' : 'Error Loading Page';
          return;
        }

        const pageData = await response.json();
        
        document.title = pageData.title;

        const article = document.createElement('article');
        article.className = 'w-full max-w-4xl mx-auto card p-8';

        const htmlContainer = document.createElement('div');
        htmlContainer.className = 'prose prose-xl max-w-none text-gray-700 leading-relaxed';
        htmlContainer.innerHTML = pageData.content;

        article.appendChild(htmlContainer);

        dynamicContentTarget.innerHTML = '';
        dynamicContentTarget.appendChild(article);
      } catch (error) {
        console.error('Error fetching dynamic page content:', error);
        dynamicContentTarget.innerHTML = '<p class="text-red-600 text-center text-xl">A network error occurred. Please try again.</p>';
        document.title = 'Network Error';
      }
    }

    if (!initialPageDataExists) {
      fetchAndRenderPageContent(slug);
    }
  
  </script>
</LayoutComponent>