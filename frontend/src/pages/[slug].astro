---
import BaseLayout from '../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const API_URL = 'http://web:80/api/pages';

  let pages = [];
  try {
    const response = await fetch(API_URL);
    if (response.ok) {
      pages = await response.json();
    } else {
      console.error('Failed to fetch pages for static paths:', response.status, response.statusText);
      return [];
    }
  } catch (error) {
    console.error('Error fetching pages for static paths:', error);
    return [];
  }

  const paths = pages
    .filter((page) => page.slug && typeof page.slug === 'string' && page.slug.trim() !== '')
    .map((page) => ({
      params: { slug: page.slug },
      props: { page },
    }));

  return paths;
}

const { page } = Astro.props;

if (!page) {
  return Astro.redirect('/404');
}

const pageTitle = page.title || 'Page Not Found';
const pageDescription = page.excerpt || (page.content ? page.content.substring(0, 150) + '...' : 'Content page from JLWC.');
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <article class="bg-white rounded-xl shadow-lg border border-gray-100 p-8 mb-12">
    <h1 class="text-4xl font-bold mb-6 text-blue-800 leading-snug">
      {page.title}
    </h1>
    <div
      class="prose prose-xl max-w-none text-gray-700 leading-relaxed"
      set:html={page.content}
    />
  </article>

  <section class="text-center mt-12">
    <a href="/" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200">
      <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H16a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd"></path></svg>
      Back to Home
    </a>
  </section>
</BaseLayout>