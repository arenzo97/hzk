---
// src/pages/[slug].astro
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Layout/Container.astro'; // Make sure this path is correct
import Button from '../components/UI/Button.astro'; // <--- ADD THIS LINE

const BUILD_TIME_API_URL = 'http://web:80/api/pages';

export async function getStaticPaths() {
  try {
    const response = await fetch(BUILD_TIME_API_URL);
    if (!response.ok) {
      console.error('Failed to fetch pages for static paths during build:', response.status, response.statusText);
      return [];
    }
    const pages = await response.json();

    const paths = pages
      .filter((page) => page.slug && typeof page.slug === 'string' && page.slug.trim() !== '')
      .map((page) => ({
        params: { slug: page.slug },
        props: { initialPageData: page },
      }));

    return paths;
  } catch (error) {
    console.error('Error fetching pages for static paths during build:', error);
    return [];
  }
}

const { slug } = Astro.params;
const { initialPageData } = Astro.props;

const CLIENT_SIDE_API_BASE_URL = 'http://localhost:8000/api/pages';

const pageTitle = initialPageData?.title || 'Loading Page...';
const pageDescription = initialPageData?.excerpt || (initialPageData?.content ? initialPageData.content.substring(0, 150) + '...' : 'Content page from JLWC.');
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <div id="page-content-wrapper" class="py-12 px-4 sm:px-6 lg:px-8 min-h-[50vh] flex items-center justify-center">
    <Container>
      {initialPageData ? (
        <article class="w-full max-w-4xl mx-auto card p-8">
          <h1>
            {initialPageData.title}
          </h1>
          <div class="prose prose-xl max-w-none text-gray-700 leading-relaxed">
            <Fragment set:html={initialPageData.content} />
          </div>
        </article>
      ) : (
        <p class="text-gray-600 text-lg text-center">Loading content dynamically...</p>
      )}
    </Container>
  </div>

  <section class="text-center mt-12">
    <Button href="/" variant="outline">
      <svg class="h-5 w-5 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H16a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" /></svg>
      Back to Home
    </Button>
  </section>

  <script define:vars={{ slug, initialPageDataExists: !!initialPageData, CLIENT_SIDE_API_BASE_URL }}>
    async function fetchAndRenderPageContent(pageSlug) {
      const pageContentWrapper = document.getElementById('page-content-wrapper');
      if (!pageContentWrapper) return;

      pageContentWrapper.innerHTML = '<p class="text-gray-600 text-lg text-center">Loading content dynamically...</p>';

      try {
        const response = await fetch(`${CLIENT_SIDE_API_BASE_URL}/${pageSlug}`);
        if (!response.ok) {
          const errorMsg = response.status === 404
            ? 'Page not found.'
            : 'An error occurred loading this page.';
          pageContentWrapper.innerHTML = `<p class="text-red-600 text-center text-xl">${errorMsg}</p>`;
          document.title = response.status === 404 ? 'Page Not Found' : 'Error Loading Page';
          return;
        }

        const pageData = await response.json();
        document.title = pageData.title;

        const article = document.createElement('article');
        article.className = 'w-full max-w-4xl mx-auto card p-8';

        const title = document.createElement('h1');
        title.className = 'text-4xl md:text-6xl font-semibold leading-tight text-center mb-6';
        title.textContent = pageData.title;

        const htmlContainer = document.createElement('div');
        htmlContainer.className = 'prose prose-xl max-w-none text-gray-700 leading-relaxed';
        htmlContainer.innerHTML = pageData.content;

        article.appendChild(title);
        article.appendChild(htmlContainer);

        pageContentWrapper.innerHTML = '';
        pageContentWrapper.appendChild(article);

      } catch (error) {
        console.error('Error fetching dynamic page content:', error);
        pageContentWrapper.innerHTML = '<p class="text-red-600 text-center text-xl">A network error occurred. Please try again.</p>';
        document.title = 'Network Error';
      }
    }

    if (!initialPageDataExists) {
      fetchAndRenderPageContent(slug);
    }
  </script>
</BaseLayout>