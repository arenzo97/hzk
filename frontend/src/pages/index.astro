---
const response = await fetch('http://web:80/api/pages');
const pages = await response.json();
import "../styles.css"; // Your main Tailwind CSS file
---

<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>JLWC Pages</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
      /* Apply a custom font if desired, or let Tailwind's default handle it */
      body {
        font-family: 'Inter', sans-serif;
      }
    </style>
  </head>
  <body class="bg-gray-50 text-gray-900 min-h-screen flex flex-col items-center py-10 px-4 sm:px-6 lg:px-8">
    <main class="max-w-4xl w-full mx-auto">
      <h1 class="text-5xl font-extrabold mb-12 text-center text-blue-700 leading-tight">
        Discover Our Pages
      </h1>

      {pages.length === 0 ? (
        <div class="bg-white p-8 rounded-xl shadow-lg border border-gray-100 text-center">
          <p class="text-xl text-gray-600">No pages found. Please add some content to the backend!</p>
        </div>
      ) : (
        <section class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {pages.map(page => (
            <article
              key={page.id}
              class="group bg-white rounded-xl shadow-lg border border-gray-100 p-8 hover:shadow-xl hover:scale-[1.02] transition-all duration-300 ease-in-out flex flex-col"
            >
              <h2 class="text-3xl font-bold mb-4 text-blue-800 leading-snug">
                {page.title}
              </h2>
              <div
                class="prose prose-lg max-w-none text-gray-700 flex-grow"
                set:html={page.content}
              />
              {/* Optional: Add a "Read More" link if you're truncating content */}
              {/* <a href={`/pages/${page.id}`} class="mt-4 text-blue-600 hover:underline font-medium">
                Read More &rarr;
              </a> */}
            </article>
          ))}
        </section>
      )}
    </main>
    <footer class="mt-16 text-gray-500 text-sm text-center">
      &copy; {new Date().getFullYear()} JLWC. All rights reserved.
    </footer>
  </body>
</html>