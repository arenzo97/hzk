---
const API_URL = 'http://web:80/api/pages';

let pages = [];
try {
  const response = await fetch(API_URL);
  if (response.ok) {
    pages = await response.json();
  } else {
    console.error('Failed to fetch pages for navigation:', response.status, response.statusText);
  }
} catch (error) {
  console.error('Error fetching pages for navigation:', error);
}
---

<header class="bg-primary text-white shadow-md">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row justify-between items-center">
    <div class="flex items-center justify-between w-full sm:w-auto mb-4 sm:mb-0">
      <a href="/" class="text-3xl font-extrabold tracking-tight hover:text-background-light transition-colors duration-200 font-serif">
        JLWC
      </a>
    </div>

    <div class="w-full sm:w-auto">
      {pages.length > 0 ? (
        <ul class="flex flex-col sm:flex-row sm:space-x-8 space-y-3 sm:space-y-0 text-lg font-medium">
          {pages
            .filter(page => page.homepage !== true)
            .map((page) => (
            <li>
              <a
                href={`/${page.slug}`}
                class="block py-2 px-3 rounded-lg hover:bg-primary hover:text-white transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-primary-hover focus:ring-opacity-50"
              >
                {page.title}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-background-light text-center sm:text-right">No pages available.</p>
      )}
    </div>
  </nav>
</header>