import Container from '../components/Layout/Container.astro';
import Button from '../components/UI/Button.astro';

// Define the API URL for events (kept for future reference, but fetch is commented out)
const API_URL = 'http://web:80/api/events';

let events = []; // Initialize events as an empty array

// --- COMMENTED OUT FOR NOW: Uncomment when you're ready to fetch real data ---
