---

<section class="py-16 bg-gray-100">
  <Container>
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">Upcoming Events</h2>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Stay connected with our vibrant community through various gatherings and activities.
      </p>
    </div>
    
    {events.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {events.map(event => (
          <div class="card p-6">
            <h3 class="text-xl font-bold mb-2 text-primary-700">{event.title}</h3>
            {event.date && <p class="text-gray-600 mb-1"><strong class="text-gray-800">Date:</strong> {event.date}</p>}
            {(event.time || event.location) && <p class="text-gray-600 mb-4">
              {event.time && <><strong class="text-gray-800">Time:</strong> {event.time}</>}
              {event.location && <>{event.time ? ' ' : ''}<strong class="text-gray-800">Location:</strong> {event.location}</>}
            </p>}
            {event.description && <p class="text-gray-700 mb-4">{event.description}</p>}
            {event.slug && (
              <a href={`/events/${event.slug}`} class="text-primary-600 font-medium hover:text-primary-700">
                View Details →
              </a>
            )}
            {!event.slug && <span class="text-gray-500 text-sm">Details coming soon</span>}
          </div>
        ))}
      </div>
    ) : (
      <p class="text-center text-gray-600 text-lg">No upcoming events at this time. Please check back soon!</p>
    )}

    <div class="mt-12 text-center">
      <Button href="/events" variant="primary">
        View All Events
      </Button>
    </div>
  </Container>
</section>